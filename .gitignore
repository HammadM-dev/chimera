node_modules/
dist/
build/
# ...except electron-builder's resources, which is a source directory that
# happens to be called `build`. The rule above matched it, so the application's
# own icons had never been committed — they existed on one machine, and a fresh
# clone failed at `postbuild` with "icon.png is missing from the working tree".
!apps/desktop/build/
!apps/desktop/build/**
out/
release/
.env
.env.*
*.log
.DS_Store
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.tsbuildinfo
.eslintcache
coverage/
.vite/
playwright-report/
test-results/

# Throwaway workspace used by `npm run dev:fresh` — a brand-new-user launch.
.dev-profile/

# The raw recordings the README's animations are built from. The finished
# .gif and .svg files in docs/assets are committed; the multi-hundred-megabyte
# source video they were rendered from is not, and can be remade with
# `CHIMERA_RECORD=1 npx playwright test e2e/assets.spec.ts`.
docs/assets/frames/
