{
  "name": "@chimera/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Electron main process and preload bridge.",
  "author": "Hammad",
  "desktopName": "chimera.desktop",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "node --test",
    "build": "npm run build --workspace @chimera/ui && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "postbuild": "node scripts/copy-app-assets.mjs",
    "start": "npm run build && electron .",
    "test:e2e": "npm run build && playwright test",
    "package": "npm run build && electron-builder --publish=never",
    "dev:fresh": "npm run build && node scripts/dev-fresh.mjs"
  },
  "devDependencies": {
    "@chimera/providers": "*",
    "@chimera/store": "*",
    "@types/nodemailer": "^8.0.1",
    "electron": "43.3.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@chimera/core": "*",
    "@composio/core": "^0.17.0",
    "@napi-rs/keyring": "^1.3.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "imapflow": "^1.7.1",
    "nodemailer": "^9.0.5"
  }
}
