{
  "name": "chimera",
  "private": true,
  "version": "0.0.0",
  "description": "Desktop application for businesses to build, run, and govern teams of AI agents across any model provider.",
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check:layout": "node scripts/check-repo-layout.mjs",
    "check:no-raw-sql": "node scripts/check-no-raw-sql.mjs",
    "docs:check-links": "node scripts/check-doc-links.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.7",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
